;; _BinkOpenDirectSound@4
proc hpimp__BinkOpenDirectSound_404 public
        Call_Asm_Stack1 BinkOpenDirectSound_c
        Call_Asm_Return 1
endp

;; _BinkSetSoundSystem@8
proc hpimp__BinkSetSoundSystem_408 public
