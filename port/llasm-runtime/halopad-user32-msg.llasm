;; HaloPad Windows runtime: user32 messages, activation, window state and input
;; (port/runtime/halopad_user32.c, part 2). Pattern and macros from SR's Septerra Core port.

include llasm.llinc
include asm-calls.llinc

func SetWindowPos_c a1, a2, a3, a4, a5, a6, a7
func MoveWindow_c a1, a2, a3, a4, a5, a6
func ShowWindow_c a1, a2
func DestroyWindow_c a1
func SetForegroundWindow_c a1
func SetActiveWindow_c a1
func SetFocus_c a1
func GetForegroundWindow_c
func GetActiveWindow_c
func GetFocus_c
func IsWindowUnicode_c a1
