func StrCmpCW_c a1, a2
func StrCmpICW_c a1, a2
func IsCharAlphaNumericW_c a1
func IsCharSpaceW_c a1
func CharUpperBuffW_c a1, a2
func CharLowerW_c a1
func OutputDebugStringA_c a1
func OutputDebugStringW_c a1
func GetAcceptLanguagesW_c a1, a2
func CreateFileW_c a1, a2, a3, a4, a5, a6, a7

;; 66: FindResourceWrapW(module, name, type) -> kernel32.FindResourceW
proc hpimp_SHLWAPI_ord66 public
        Call_Asm_Stack3 FindResourceW_c
        Call_Asm_Return 3
endp

