;; HaloPad Windows runtime: SHLWAPI services msxml4.dll imports. Named exports bind to
;; port/runtime/halopad_shlwapi.c. SRW names an unnamed ordinal import <DLL>_ord<n>; each is
;; bound here to the service it forwards to on Windows XP, as Wine's dlls/shlwapi/shlwapi.spec
;; records them. Ordinals not listed stay traps that name the ordinal. Pattern and macros from
;; SR's Septerra Core port.

include llasm.llinc
include asm-calls.llinc

func FindResourceW_c a1, a2, a3
