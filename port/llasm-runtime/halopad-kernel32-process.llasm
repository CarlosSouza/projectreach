;; HaloPad Windows runtime: kernel32 process, thread, memory, locale and time services.
;; Written from a table of service names and argument counts; maintained by hand.
;; Each procedure passes its stdcall arguments (guest values) to the C implementation in
;; port/runtime/halopad_k32_process.c, halopad_heap.c or halopad_vmem.c, sets eax and
;; pops the arguments. Pattern and macros from SR's Septerra Core port (asm-calls.llinc).

include llasm.llinc
include asm-calls.llinc

func GetLastError_c
funcv SetLastError_c a1
func GetVersionExA_c a1
funcv GetSystemInfo_c a1
func IsProcessorFeaturePresent_c a1
func GetCommandLineA_c
funcv GetStartupInfoA_c a1
func GetStdHandle_c a1
func GetFileType_c a1
func SetHandleCount_c a1
func GetModuleHandleA_c a1
func LoadLibraryA_c a1
func FreeLibrary_c a1
func GetProcAddress_c a1, a2
func InitializeCriticalSectionAndSpinCount_c a1, a2
func GetModuleFileNameA_c a1, a2, a3
func GetEnvironmentStringsW_c
func GetEnvironmentStrings_c
func FreeEnvironmentStringsW_c a1
func FreeEnvironmentStringsA_c a1
func GetCurrentProcess_c
func GetCurrentThread_c
func GetCurrentProcessId_c
func GetCurrentThreadId_c
funcv ExitProcess_c a1
func SetUnhandledExceptionFilter_c a1
func TlsAlloc_c
func TlsGetValue_c a1
func TlsSetValue_c a1, a2
func TlsFree_c a1
funcv InitializeCriticalSection_c a1
funcv EnterCriticalSection_c a1
funcv LeaveCriticalSection_c a1
funcv DeleteCriticalSection_c a1
func InterlockedExchange_c a1, a2
funcv GetSystemTimeAsFileTime_c a1
func GetTickCount_c
func QueryPerformanceFrequency_c a1
func QueryPerformanceCounter_c a1
func GetACP_c
func GetOEMCP_c
func IsValidCodePage_c a1
func GetCPInfo_c a1, a2
func MultiByteToWideChar_c a1, a2, a3, a4, a5, a6
func GetStringTypeW_c a1, a2, a3, a4
func GetStringTypeA_c a1, a2, a3, a4, a5
func LCMapStringW_c a1, a2, a3, a4, a5, a6
func LCMapStringA_c a1, a2, a3, a4, a5, a6
func WideCharToMultiByte_c a1, a2, a3, a4, a5, a6, a7, a8
func VirtualAlloc_c a1, a2, a3, a4
func VirtualFree_c a1, a2, a3
func VirtualQuery_c a1, a2, a3
func VirtualProtect_c a1, a2, a3, a4
func HeapCreate_c a1, a2, a3
func GetProcessHeap_c
func HeapDestroy_c a1
func HeapAlloc_c a1, a2, a3
func HeapFree_c a1, a2, a3
func HeapSize_c a1, a2, a3
func HeapReAlloc_c a1, a2, a3, a4
func GlobalAlloc_c a1, a2
func LocalAlloc_c a1, a2
func GlobalFree_c a1
func LocalFree_c a1
func GlobalReAlloc_c a1, a2, a3
func GlobalLock_c a1
func GlobalUnlock_c a1

proc hpimp_GetLastError public
        Call_Asm_Stack0 GetLastError_c
        Call_Asm_Return 0
endp

proc hpimp_SetLastError public
        Call_Asm_Stack1_void SetLastError_c
        Call_Asm_Return 1
endp

